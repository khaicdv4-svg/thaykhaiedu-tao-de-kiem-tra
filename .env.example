# ==============================================================================
# THAYKHAIEDU - SUPABASE ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in your Supabase project credentials.
# NEVER commit .env.local or any secret keys to Git repository.
# ==============================================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key (Safe for client-side use with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# IMPORTANT SECURITY WARNING:
# DO NOT put SUPABASE_SERVICE_ROLE_KEY in frontend or public environment files!
